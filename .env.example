APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8000

# Local MySQL (the server you manage with MySQL Workbench)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=task_manager
DB_USERNAME=root
DB_PASSWORD=

# Shared secret with the Django service (same value as SERVICE_TOKEN in its .env)
OVERDUE_SERVICE_URL=http://127.0.0.1:8001
OVERDUE_SERVICE_TOKEN=change-me-shared-secret