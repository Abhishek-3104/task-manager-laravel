# Copy to deploy.env and edit before running setup.sh.

# Leave DOMAIN empty to serve over HTTP on the instance's public IP.
# Set DOMAIN (DNS A record -> your Elastic IP) and LETSENCRYPT_EMAIL to get free HTTPS.
DOMAIN=
LETSENCRYPT_EMAIL=

# Must be the same for Laravel and Django.
APP_TIMEZONE=Asia/Kolkata

# MySQL 8 is installed on this EC2 instance (localhost only).
DB_DATABASE=task_manager
DB_USERNAME=task_manager
# Leave empty: a strong password is generated and saved in /etc/task-manager/secrets.env
DB_PASSWORD=

# Load demo projects/tasks and the test accounts (runs only once).
SEED_DEMO_DATA=true
